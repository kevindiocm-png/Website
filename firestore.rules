rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'kevindiocm@gmail.com' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // Health check collection for getDocFromServer test
    match /test/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // User profiles
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if (isOwner(userId) && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']))) || isAdmin();
      allow delete: if isAdmin();
    }

    // Orders & Invoices
    match /orders/{orderId} {
      allow read: if true; // allow tracking/viewing invoice by ID for invoice links
      allow create: if true; // allows guest or logged in checkout
      allow update: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // Sparepart Catalog Products
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if true; // allowing in-app builder edits for store owner
    }

    match /catalog/{docId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Physical Branches
    match /branches/{branchId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    match /store/{docId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Global Store Settings (Theme, Hero, Banner, Contact)
    match /settings/{settingId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Customer Consultation Requests
    match /consultations/{consultationId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }
  }
}
